# BioOS Runtime Configuration (copy to .env or export in your shell)
# Every variable is optional; defaults shown.

# Persistence (SQLite WAL store for telemetry + audit chain)
BIOOS_DB_PATH=data/bioos_runtime.db

# Background AMSV telemetry sampler rate in Hz (0 disables)
BIOOS_TELEMETRY_HZ=2

# HL7 v2 MLLP listener port (unset = disabled)
BIOOS_MLLP_PORT=

# Authentication
# 0 = dev-bypass (flight deck works without tokens)
# 1 = enforce RBAC on /api/* (UI fetches tokens from POST /api/auth/token)
BIOOS_AUTH_REQUIRED=0
BIOOS_JWT_SECRET=bioos-dev-secret-DO-NOT-USE-IN-PRODUCTION
BIOOS_SERVICE_API_KEY=

# Production authentication: hospital OIDC provider (Keycloak/Entra/etc.)
# When set, bearer tokens verify via RS256 + JWKS; dev HS256 is isolated.
BIOOS_OIDC_ISSUER=
BIOOS_OIDC_AUDIENCE=

# Plane A kernel cdylib override (auto-resolves dll/so/dylib by platform)
BIOOS_KERNEL_LIB=
