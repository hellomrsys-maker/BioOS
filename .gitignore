# Rust Build Artifacts
target/
**/target/
# NOTE: Cargo.lock is intentionally COMMITTED. Reproducible dependency
# resolution is required for safety-critical verification builds.

# Python Cache & Testing
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Logs & Temporary Files
*.log
**/*.log

# Local runtime data (SQLite WAL persistence store)
data/
*.db
*.db-wal
*.db-shm

# Operating System Files
Thumbs.db
Desktop.ini
.DS_Store
